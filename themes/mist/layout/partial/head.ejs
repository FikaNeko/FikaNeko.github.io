<%#
  Mist · <head>
  ─────────────────────────────────────────────────
  meta / SEO（canonical + Open Graph）/ favicon / RSS /
  样式入口 / 主题配置 → CSS 变量覆盖层 / 防闪烁内联主题脚本
  说明：
  - 样式引入顺序固定：tokens → base → layout → components → prose → pages
    （@import 顺序在 style.css 内维护）
  - 覆盖层只输出「用户可配置」的变量；accent-soft 等派生色
    由 tokens.css / helpers.js（后续轮次）负责
%>
<%
  const pageTitle = page.title ? page.title + ' · ' + config.title : config.title;
  const plainDesc = (page.excerpt ? strip_html(page.excerpt).replace(/\s+/g, ' ').trim() : '');
  const pageDesc = (page.description || plainDesc || config.description || '').slice(0, 160);
  const pageImage = page.cover || theme.brand.avatar || '';
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="color-scheme" content="light dark">
  <link rel="canonical" href="<%- full_url_for(page.path) %>">

  <%/* Open Graph（文章页为 article 类型，其余 website） */%>
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%- full_url_for(page.path) %>">
  <% if (pageImage) { %><meta property="og:image" content="<%- full_url_for(pageImage) %>"><% } %>
  <meta name="twitter:card" content="summary">

  <link rel="icon" href="<%- url_for('img/favicon.svg') %>" type="image/svg+xml">
  <% if (theme.social && theme.social.rss) { %>
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for(theme.social.rss) %>">
  <% } %>

  <%# 背景图预载：提前拉取并进入内存缓存，收窄 MPA 页面切换时
      背景层"取回→解码"的空窗期（闪烁的主要来源） %>
  <% if (theme.background && theme.background.image) { %>
  <link rel="preload" as="image" href="<%- url_for(theme.background.image) %>">
  <% } %>

  <%/* 样式入口（含固定顺序的 @import） */%>
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>">

  <%#
    主题 _config.yml → CSS 变量覆盖层
    用户改配置即生效，无需触碰 tokens.css；
    关闭某能力时以“归零变量”实现（阴影清空 / 时长归 0 / 玻璃参数失效）
  %>
  <style>
    :root {
      --radius-sm: <%= theme.shape.radius_sm %>;
      --radius-md: <%= theme.shape.radius_md %>;
      --radius-lg: <%= theme.shape.radius_lg %>;
      --glass-blur: <%= theme.glass.blur %>;
      --glass-saturate: <%= theme.glass.saturate %>;
      --glass-opacity: <%= theme.glass.opacity %>;
      --dur-fast: <%= theme.motion.duration.fast %>;
      --dur-base: <%= theme.motion.duration.base %>;
      --dur-slow: <%= theme.motion.duration.slow %>;
      --ease-out: <%= theme.motion.easing %>;
    }
    <% if (!theme.shape.shadow) { %>:root { --shadow-sm: none; --shadow-md: none; }<% } %>
    <% if (!theme.motion.enabled) { %>:root { --dur-fast: 0s; --dur-base: 0s; --dur-slow: 0s; }<% } %>
    <% if (!theme.glass.enabled) { %>:root { --glass-blur: 0px; --glass-opacity: 1; }<% } %>
    <%#
      背景图（background.image 配置后才注入；遮罩色 --bg-overlay-color
      在 tokens.css 中随明暗主题切换，此处只决定 α 与图片地址）
    %>
    <% if (theme.background && theme.background.image) { %>
    :root {
      --bg-overlay-alpha: <%= theme.background.overlay != null ? theme.background.overlay : 0.6 %>;
      --bg-image: url("<%- url_for(theme.background.image) %>");
      --bg-layers: linear-gradient(var(--bg-overlay-color), var(--bg-overlay-color)), var(--bg-image);
    }
    <% } %>
    <%# 首页字号（home.font_size，留空用主题默认；pages.css 以
        var() 兜底消费这些变量） %>
    <%
      const fs = (theme.home && theme.home.font_size) || {};
      if (fs.title || fs.bio || fs.hitokoto) {
    %>
    :root {
      <% if (fs.title) { %>--hero-title-size: <%= fs.title %>;<% } %>
      <% if (fs.bio) { %>--hero-bio-size: <%= fs.bio %>;<% } %>
      <% if (fs.hitokoto) { %>--hitokoto-size: <%= fs.hitokoto %>;<% } %>
    }
    <% } %>

    <%/* 明暗两套语义色（与 _config.yml colors.* 一一对应） */%>
    :root {
      --color-bg: <%= theme.colors.light.bg %>;
      --color-surface: <%= theme.colors.light.surface %>;
      --color-text: <%= theme.colors.light.text %>;
      --color-text-secondary: <%= theme.colors.light.text_secondary %>;
      --color-text-tertiary: <%= theme.colors.light.text_tertiary %>;
      --color-border: <%= theme.colors.light.border %>;
      --color-accent: <%= theme.colors.light.accent %>;
    }
    html[data-theme="dark"] {
      --color-bg: <%= theme.colors.dark.bg %>;
      --color-surface: <%= theme.colors.dark.surface %>;
      --color-text: <%= theme.colors.dark.text %>;
      --color-text-secondary: <%= theme.colors.dark.text_secondary %>;
      --color-text-tertiary: <%= theme.colors.dark.text_tertiary %>;
      --color-border: <%= theme.colors.dark.border %>;
      --color-accent: <%= theme.colors.dark.accent %>;
    }
  </style>

  <%#
    防闪烁（FOUC）：首屏渲染前确定 data-theme
    优先级：localStorage 记忆（appearance.remember 控制）> 配置默认 > 系统偏好
    之后的切换与监听由 theme.js（后续轮次）接管
  %>
  <script>
    (function () {
      var saved = null;
      <% if (theme.appearance.remember) { %>try { saved = localStorage.getItem('mist-theme'); } catch (e) {}<% } %>
      var mode = saved || '<%= theme.appearance.default %>';
      if (mode === 'auto') {
        mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', mode === 'dark' ? 'dark' : 'light');
      document.documentElement.classList.remove('no-js');
    })();
  </script>
</head>
