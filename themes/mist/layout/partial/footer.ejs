<%#
  Mist · 页脚
  单行克制排版：© 起始年份–当前年份 · 持有人 · 备案号 · Powered by
  与内容区以发丝线分隔（样式见 layout.css）
%>
<%
  const year = new Date().getFullYear();
  const since = theme.footer.since || year;
  const holder = theme.footer.copyright_holder || config.author || config.title;
%>
<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copyright">
      © <%= since === year ? since : since + '–' + year %> <%= holder %>
      <% if (theme.footer.icp) { %>
      <a class="site-footer__icp" href="<%= (theme.footer && theme.footer.icp_url) || 'https://beian.miit.gov.cn/' %>" target="_blank" rel="noopener"><%= theme.footer.icp %></a>
      <% } %>
    </p>
    <%/* 网站运行时间：结构服务端渲染（数字留空、min-width 预占宽），
        首屏排版即完整、零布局位移；uptime.js 只负责填数字与每秒更新
        （数字变动为模糊淡出→淡入） */%>
    <% if (theme.footer.uptime && theme.footer.uptime.enable) { %>
    <span class="site-footer__uptime js-uptime<%= theme.footer.uptime.wrap ? ' site-footer__uptime--wrap' : '' %>"
          data-start="<%= theme.footer.uptime.start %>">
      <span class="site-footer__uptime-prefix"><%= __('footer.uptime_prefix') %></span>
      <span class="uptime-seg"><span class="uptime-seg-num"></span><span class="uptime-seg-unit"><%= __('footer.uptime_d') %></span></span>
      <span class="uptime-seg"><span class="uptime-seg-num"></span><span class="uptime-seg-unit"><%= __('footer.uptime_h') %></span></span>
      <span class="uptime-seg"><span class="uptime-seg-num"></span><span class="uptime-seg-unit"><%= __('footer.uptime_m') %></span></span>
      <span class="uptime-seg"><span class="uptime-seg-num"></span><span class="uptime-seg-unit"><%= __('footer.uptime_s') %></span></span>
    </span>
    <script>
      /* 同步预填数字：解析期执行，早于首帧绘制——刷新时数字无闪烁；
         之后的每秒更新由 uptime.js 接管（其首帧会静默同步此值） */
      (function () {
        var el = document.querySelector('.js-uptime');
        if (!el) return;
        var start = new Date(String(el.getAttribute('data-start') || '').replace(/-/g, '/')).getTime();
        if (isNaN(start)) return;
        var diff = Math.max(0, Math.floor((Date.now() - start) / 1000));
        var d = Math.floor(diff / 86400); diff -= d * 86400;
        var h = Math.floor(diff / 3600); diff -= h * 3600;
        var m = Math.floor(diff / 60);
        var s = diff - m * 60;
        var vals = [String(d), ('0' + h).slice(-2), ('0' + m).slice(-2), ('0' + s).slice(-2)];
        var nodes = el.querySelectorAll('.uptime-seg-num');
        for (var i = 0; i < nodes.length && i < 4; i++) nodes[i].textContent = vals[i];
      })();
    </script>
    <% } %>
    <% if (theme.footer.powered_by) { %>
    <p class="site-footer__powered"><%= __('footer.powered_by') %></p>
    <% } %>
  </div>
</footer>
